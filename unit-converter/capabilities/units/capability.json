{
  "schemaVersion": 1,
  "id": "units",
  "version": "1.0.0",
  "description": "Deterministic scalar unit conversion for length, mass and temperature.",
  "runtime": "javascript-sandbox-v1",
  "entry": "runtime.js",
  "tools": [
    {
      "id": "convert",
      "description": "Convert one measurement. Input: { value: number, from: string, to: string } using the unit symbols listed in SKILL.md.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "value": { "type": "number" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "required": ["value", "from", "to"],
        "additionalProperties": false
      },
      "resultKinds": ["json"]
    }
  ],
  "permissions": {}
}
