{
  "schemaVersion": 2,
  "id": "cartography",
  "provides": "research-visuals:cartography",
  "version": "1.1.0",
  "description": "Research maps through the native cartographic renderer, with dated-source reporting for historical maps.",
  "runtime": {
    "kind": "nodus-trusted-worker-v1",
    "protocol": 1,
    "entry": "worker.js"
  },
  "requires": [
    {
      "id": "nodus:maps",
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    }
  ],
  "tools": [
    {
      "id": "render-map",
      "description": "Render supplied or approved-provider geography with attribution. openhistoricalmap retrieves dated administrative boundaries inside the request bounds when a level (2 or 4) and a period are given.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "width": {
            "type": "number",
            "minimum": 640,
            "maximum": 1600
          },
          "height": {
            "type": "number",
            "minimum": 480,
            "maximum": 1400
          },
          "projection": {
            "type": "string",
            "enum": [
              "equal-earth",
              "mercator",
              "equirectangular"
            ]
          },
          "detail": {
            "type": "string",
            "enum": [
              "standard",
              "full"
            ]
          },
          "centralMeridian": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "layers": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "natural-earth",
                        "geoboundaries",
                        "openhistoricalmap"
                      ]
                    },
                    "country": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "period": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string"
                        },
                        "to": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "provider"
                  ],
                  "additionalProperties": false
                },
                "datasetId": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "geojson": {
                      "type": "object"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "attribution": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "license": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1500
                        },
                        "period": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string"
                            },
                            "to": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "label",
                        "attribution",
                        "license"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "geojson",
                    "source"
                  ],
                  "additionalProperties": false
                },
                "select": {
                  "type": "object",
                  "properties": {
                    "property": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {},
                      "minItems": 1,
                      "maxItems": 5000
                    }
                  },
                  "required": [
                    "property",
                    "values"
                  ],
                  "additionalProperties": false
                },
                "fill": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 7
                },
                "colors": {
                  "type": "object",
                  "properties": {
                    "property": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {},
                          "color": {
                            "type": "string",
                            "minLength": 7,
                            "maxLength": 7
                          }
                        },
                        "required": [
                          "value",
                          "color"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 1000
                    }
                  },
                  "required": [
                    "property",
                    "values"
                  ],
                  "additionalProperties": false
                },
                "labelProperty": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "markers": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "color": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 7
                },
                "radius": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 16
                }
              },
              "required": [
                "coordinates"
              ],
              "additionalProperties": false
            }
          },
          "routes": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 2,
                  "maxItems": 100
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "curved",
                    "great-circle"
                  ]
                },
                "arrow": {
                  "type": "boolean"
                },
                "color": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 7
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 12
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "coordinates"
              ],
              "additionalProperties": false
            }
          },
          "overlaySource": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              },
              "period": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "label",
              "attribution",
              "license"
            ],
            "additionalProperties": false
          },
          "legend": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "color": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 7
                }
              },
              "required": [
                "label",
                "color"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "alt"
        ],
        "additionalProperties": false
      },
      "artifactTypes": [
        "research-map"
      ],
      "timeoutMs": 30000,
      "concurrency": 1,
      "maxPerReply": 4,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
