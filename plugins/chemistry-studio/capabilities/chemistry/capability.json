{
  "schemaVersion": 2,
  "id": "chemistry",
  "provides": "nodus:chemistry",
  "version": "2.5.1",
  "description": "Resolve chemical identities against references, validate the structure, and draw it as a verified document.",
  "runtime": { "kind": "nodus-trusted-worker-v1", "protocol": 1, "entry": "worker.js" },
  "requires": [{ "id": "nodus:svg", "minVersion": "1.0.0", "maxVersionExclusive": "2.0.0" }],
  "tools": [
    {
      "id": "compile",
      "description": "Resolve and draw one chemistry plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan": { "type": "string", "minLength": 2, "maxLength": 64000 },
          "question": { "type": "string", "maxLength": 8000 }
        },
        "required": ["plan"],
        "additionalProperties": false
      },
      "artifactTypes": ["chemistry-document"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": true
    },
    {
      "id": "inspect",
      "description": "Parse a batch of SMILES with RDKit and return their verified graphs without drawing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "smiles": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "minItems": 1, "maxItems": 24 }
        },
        "required": ["smiles"],
        "additionalProperties": false
      },
      "artifactTypes": ["molecule-dossier"],
      "timeoutMs": 120000,
      "concurrency": 2,
      "maxPerReply": 4,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "resolve-names",
      "description": "Resolve systematic chemical names to structures with the reference services (PubChem exact match first, OPSIN fallback), reporting ambiguous and unresolved names with feedback.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "names": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "minItems": 1, "maxItems": 48 }
        },
        "required": ["names"],
        "additionalProperties": false
      },
      "artifactTypes": ["species-resolution"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 2,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "verify-route",
      "description": "Parse every step of a synthesis route with RDKit, check each equation and confirm each intermediate is carried over unchanged, and check every supplied IUPAC name against the structure it denotes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 4000 }, "minItems": 1, "maxItems": 16 },
          "carriers": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 16 },
          "racemic": { "type": "boolean" },
          "target": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "labels": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string", "enum": ["reactant", "product", "agent"] },
                  "byproduct": { "type": "boolean" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "smiles": { "type": "string", "minLength": 1, "maxLength": 2000 }
                },
                "required": ["role", "name", "smiles"],
                "additionalProperties": false
              }
            }
          }
        },
        "required": ["steps"],
        "additionalProperties": false
      },
      "artifactTypes": ["route-audit"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    }
  ],
  "chat": {
    "priority": 300,
    "requestProtocols": [
      { "fence": "chemistry-plan", "toolId": "compile", "maxPerReply": 1, "answerMode": "replace-block" }
    ],
    "legacyResults": [
      { "fence": "chemistry-document", "artifactType": "chemistry-document", "artifactVersion": 2 },
      { "fence": "chemistry-notice", "artifactType": "chemistry-document", "artifactVersion": 2 }
    ],
    "hooks": { "prepare": true },
    "pendingLabel": { "en": "Drawing your structure…", "es": "Dibujando tu estructura…", "fr": "Dessin de votre structure…", "de": "Struktur wird gezeichnet…", "pt": "A desenhar a tua estrutura…", "pt-BR": "Desenhando sua estrutura…", "it": "Disegno della struttura…", "tr": "Yapınız çiziliyor…" }
  },
  "artifacts": [
    {
      "type": "chemistry-document",
      "version": 2,
      "label": { "en": "Chemistry document", "es": "Documento de química", "fr": "Document de chimie", "de": "Chemie-Dokument", "pt": "Documento de química", "pt-BR": "Documento de química", "it": "Documento di chimica", "tr": "Kimya belgesi" },
      "modelVisibility": "projection",
      "decodes": ["chemfig", "smiles", "lewis"]
    },
    {
      "type": "molecule-dossier",
      "version": 1,
      "label": { "en": "Molecule dossier", "es": "Ficha molecular", "fr": "Fiche moléculaire", "de": "Molekül-Dossier", "pt": "Ficha molecular", "pt-BR": "Ficha molecular", "it": "Scheda molecolare", "tr": "Molekül dosyası" },
      "modelVisibility": "projection"
    },
    {
      "type": "route-audit",
      "version": 1,
      "label": { "en": "Route audit", "es": "Auditoría de ruta", "fr": "Audit de voie", "de": "Routenprüfung", "pt": "Auditoria de rota", "pt-BR": "Auditoria de rota", "it": "Audit di via", "tr": "Rota denetimi" },
      "modelVisibility": "projection"
    },
    {
      "type": "species-resolution",
      "version": 1,
      "label": { "en": "Species resolution", "es": "Resolución de especies", "fr": "Résolution des espèces", "de": "Spezies-Auflösung", "pt": "Resolução de espécies", "pt-BR": "Resolução de espécies", "it": "Risoluzione delle specie", "tr": "Tür çözümlemesi" },
      "modelVisibility": "projection"
    }
  ],
  "permissions": {
    "network": [
      { "id": "opsin", "origin": "https://www.ebi.ac.uk", "pathPrefixes": ["/opsin/ws/"], "methods": ["GET"], "maxResponseBytes": 1048576, "timeoutMs": 30000 },
      { "id": "pubchem", "origin": "https://pubchem.ncbi.nlm.nih.gov", "pathPrefixes": ["/rest/pug/compound/"], "methods": ["GET"], "maxResponseBytes": 4194304, "timeoutMs": 30000 }
    ],
    "model": { "maxCalls": 2, "purpose": "Repair a structurally invalid plan, or draw an explicitly unverified fallback when the verified lane abstains." },
    "svg": true,
    "subworkers": { "max": 1 },
    "storage": { "stateBytes": 65536, "cacheBytes": 4194304, "tempBytes": 0 }
  }
}
