{
  "schemaVersion": 2,
  "id": "chemistry",
  "provides": "nodus:chemistry",
  "version": "2.9.0",
  "description": "Resolve chemical identities against references, validate the structure, draw it as a verified document, and check a step against known reactions.",
  "runtime": { "kind": "nodus-trusted-worker-v1", "protocol": 1, "entry": "worker.js" },
  "requires": [{ "id": "nodus:svg", "minVersion": "1.0.0", "maxVersionExclusive": "2.0.0" }],
  "tools": [
    {
      "id": "compile",
      "description": "Resolve and draw one chemistry plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "plan": { "type": "string", "minLength": 2, "maxLength": 64000 },
          "question": { "type": "string", "maxLength": 64000 },
          "pubchemDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "opsinDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "localOnly": { "type": "boolean" }
        },
        "required": ["plan"],
        "additionalProperties": false
      },
      "artifactTypes": ["chemistry-document"],
      "timeoutMs": 180000,
      "concurrency": 2,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": true
    },
    {
      "id": "inspect",
      "description": "Parse a batch of SMILES with RDKit and return their verified graphs without drawing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "smiles": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4000 }, "minItems": 1, "maxItems": 24 }
        },
        "required": ["smiles"],
        "additionalProperties": false
      },
      "artifactTypes": ["molecule-dossier"],
      "timeoutMs": 120000,
      "concurrency": 2,
      "maxPerReply": 4,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "resolve-names",
      "description": "Resolve systematic chemical names to structures with the reference services (PubChem exact match first, OPSIN fallback), reporting ambiguous and unresolved names with feedback.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "names": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4000 }, "minItems": 1, "maxItems": 512 },
          "pubchemDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "opsinDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "localOnly": { "type": "boolean" }
        },
        "required": ["names"],
        "additionalProperties": false
      },
      "artifactTypes": ["species-resolution"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 2,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "resolve-structure",
      "description": "Name structures with the reference services: RDKit canonicalises each isomeric SMILES and PubChem supplies its IUPAC name and CID when it holds the structure.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "smiles": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4000 }, "minItems": 1, "maxItems": 512 },
          "pubchemDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "localOnly": { "type": "boolean" }
        },
        "required": ["smiles"],
        "additionalProperties": false
      },
      "artifactTypes": ["structure-naming"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 2,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "verify-route",
      "description": "Parse every step of a synthesis route with RDKit, check each equation and confirm each intermediate is carried over unchanged, and check every supplied IUPAC name against the structure it denotes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 64000 }, "minItems": 1, "maxItems": 512 },
          "carriers": { "type": "array", "items": { "type": "string", "maxLength": 4000 }, "maxItems": 512 },
          "racemic": { "type": "boolean" },
          "rearrangement": { "type": "array", "items": { "type": "boolean" }, "maxItems": 512 },
          "radical": { "type": "array", "items": { "type": "boolean" }, "maxItems": 512 },
          "target": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "enumerateStereo": { "type": "boolean" },
          "pubchemDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "opsinDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "localOnly": { "type": "boolean" },
          "labels": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "role": { "type": "string", "enum": ["reactant", "product", "agent"] },
                  "byproduct": { "type": "boolean" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 4000 },
                  "smiles": { "type": "string", "minLength": 1, "maxLength": 4000 }
                },
                "required": ["role", "name", "smiles"],
                "additionalProperties": false
              }
            }
          }
        },
        "required": ["steps"],
        "additionalProperties": false
      },
      "artifactTypes": ["route-audit"],
      "timeoutMs": 180000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "execute-route-program",
      "description": "Execute an explicitly supplied route program and audit its generated equations with the existing route checker. Application-invoked alternate format; ordinary synthesis answers retain the host output contract. Stops on the first failure and never establishes experimental feasibility.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64000
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "indexDir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "pubchemDir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "opsinDir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "localOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "program"
        ],
        "additionalProperties": false
      },
      "artifactTypes": [
        "route-audit"
      ],
      "timeoutMs": 300000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "known-reactions",
      "description": "Look up a proposed reaction or a product in the local Open Reaction Database index: exact precedents, the reactions that make a product, and the most similar known reactions, with a drawing of the closest one exactly as recorded (unbalanced). The application supplies the index directory; this tool is not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "indexDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "reactions": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 4000 }, "maxItems": 32 },
          "products": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 32 },
          "similar": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 4000 }, "maxItems": 16 }
        },
        "required": ["indexDir"],
        "additionalProperties": false
      },
      "artifactTypes": ["reaction-precedent"],
      "timeoutMs": 300000,
      "concurrency": 2,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "propose-disconnections",
      "description": "Propose one-step disconnections for route targets from the local Open Reaction Database index: the recorded reactions that make each target, and retro templates extracted from the index (applied with RDChiral) ranked by recorded precedent, precursor availability and closeness to the route's starting materials, each tagged with its reaction class. The application supplies the index directory; this tool is not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "indexDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "targets": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "minItems": 1, "maxItems": 16 },
          "startingMaterials": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 16 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 32 },
          "stockDir": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "required": ["indexDir", "targets"],
        "additionalProperties": false
      },
      "artifactTypes": ["reaction-disconnections"],
      "timeoutMs": 300000,
      "concurrency": 4,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "propose-forward-steps",
      "description": "The forward transformations that APPLY to a molecule, each with the product it gives and how often it is recorded. Ask for this when you know what you want to do to a molecule and want the transformations the recorded chemistry supports, rather than proposing one yourself. An empty list means the index supports none, which is an answer. Apply the one you choose with execute-route-program, passing its smarts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "molecule": {"type": "string", "minLength": 1, "maxLength": 4000},
          "reagents": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 4000}, "maxItems": 4},
          "limit": {"type": "integer", "minimum": 1, "maximum": 25},
          "indexDir": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["molecule"],
        "additionalProperties": false
      },
      "artifactTypes": ["forward-steps"],
      "timeoutMs": 60000,
      "concurrency": 1,
      "maxPerReply": 4,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "decompose-target",
      "description": "Break assembled targets into the units they were built from: find the bonds joining one unit to the next, cut them, take the protecting groups off each fragment, and name each one against the user's local unit library. This lets a retro search be asked about a small molecule instead of a large one. Without a library the fragments are still returned, unnamed. The application supplies the library directory; this tool is not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "targets": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "minItems": 1, "maxItems": 8 },
          "monomerDir": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "required": ["targets"],
        "additionalProperties": false
      },
      "artifactTypes": ["target-decomposition"],
      "timeoutMs": 60000,
      "concurrency": 4,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "check-stock",
      "description": "Check which of the user's imported vendor stock lists (Mcule, Enamine, …) hold each molecule, matched by standard InChIKey. The application supplies the stock directory; this tool is not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stockDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "molecules": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "minItems": 1, "maxItems": 64 }
        },
        "required": ["stockDir", "molecules"],
        "additionalProperties": false
      },
      "artifactTypes": ["stock-availability"],
      "timeoutMs": 120000,
      "concurrency": 2,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "search-routes",
      "description": "Search multi-step routes backwards from a target over local reaction indexes (ORD snapshot, the user's textbook-scheme index): recorded reactions and retro-template disconnections, ending in starting materials, stocked molecules, inorganics or routine reagents. Returns the cheapest complete routes found within the time budget, each step with its provenance. The application supplies the directories; this tool is not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "indexDirs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "minItems": 1, "maxItems": 4 },
          "target": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "startingMaterials": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 16 },
          "maxSteps": { "type": "integer", "minimum": 1, "maximum": 6 },
          "stockDir": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "budgetSeconds": { "type": "integer", "minimum": 5, "maximum": 240 }
        },
        "required": ["indexDirs", "target"],
        "additionalProperties": false
      },
      "artifactTypes": ["candidate-routes"],
      "timeoutMs": 300000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "check-compatibility",
      "description": "Check each route step for functional groups that survive into the product although a reagent named in the step's conditions attacks them (an ester under LiAlH4, a free OH under a Grignard, a Cbz under H2/Pd), and protecting groups that vanish with no reagent that removes them. Each hazard says why and how to protect the group, with textbook examples when a textbook index is given. Not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "reactants": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 12 },
                "products": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 12 },
                "reagents": { "type": "string", "maxLength": 2000 }
              },
              "required": ["reactants", "products"],
              "additionalProperties": false
            }
          },
          "textbookDir": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "required": ["steps"],
        "additionalProperties": false
      },
      "artifactTypes": ["step-compatibility"],
      "timeoutMs": 120000,
      "concurrency": 1,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    },
    {
      "id": "aggregation-advisory",
      "description": "On-resin aggregation for one peptide target: read the chain from its structure, then report which hydropathy window is suspect and which positions could carry a pseudoproline. A suspicion, not a finding - aggregation cannot be predicted reliably from sequence - so it never says a synthesis will stall. `applies` is false when the target is not a readable peptide chain, which differs from one with nothing suspect in it. Available for application-side route integration; not offered to the model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "required": ["target"],
        "additionalProperties": false
      },
      "artifactTypes": ["aggregation-advisory"],
      "timeoutMs": 30000,
      "concurrency": 4,
      "maxPerReply": 1,
      "answerMode": "replace-block",
      "metered": false,
      "billing": "none"
    }
  ],
  "chat": {
    "priority": 300,
    "requestProtocols": [
      { "fence": "chemistry-plan", "toolId": "compile", "maxPerReply": 1, "answerMode": "replace-block" },
      { "fence": "forward-steps", "toolId": "propose-forward-steps", "maxPerReply": 4, "answerMode": "replace-block" }
    ],
    "legacyResults": [
      { "fence": "chemistry-document", "artifactType": "chemistry-document", "artifactVersion": 2 },
      { "fence": "chemistry-notice", "artifactType": "chemistry-document", "artifactVersion": 2 }
    ],
    "hooks": { "prepare": true },
    "pendingLabel": { "en": "Drawing your structure…", "es": "Dibujando tu estructura…", "fr": "Dessin de votre structure…", "de": "Struktur wird gezeichnet…", "pt": "A desenhar a tua estrutura…", "pt-BR": "Desenhando sua estrutura…", "it": "Disegno della struttura…", "tr": "Yapınız çiziliyor…" }
  },
  "artifacts": [
    {
      "type": "chemistry-document",
      "version": 2,
      "label": { "en": "Chemistry document", "es": "Documento de química", "fr": "Document de chimie", "de": "Chemie-Dokument", "pt": "Documento de química", "pt-BR": "Documento de química", "it": "Documento di chimica", "tr": "Kimya belgesi" },
      "modelVisibility": "projection",
      "decodes": ["chemfig", "smiles", "lewis"]
    },
    {
      "type": "molecule-dossier",
      "version": 1,
      "label": { "en": "Molecule dossier", "es": "Ficha molecular", "fr": "Fiche moléculaire", "de": "Molekül-Dossier", "pt": "Ficha molecular", "pt-BR": "Ficha molecular", "it": "Scheda molecolare", "tr": "Molekül dosyası" },
      "modelVisibility": "projection"
    },
    {
      "type": "route-audit",
      "version": 1,
      "label": { "en": "Route audit", "es": "Auditoría de ruta", "fr": "Audit de voie", "de": "Routenprüfung", "pt": "Auditoria de rota", "pt-BR": "Auditoria de rota", "it": "Audit di via", "tr": "Rota denetimi" },
      "modelVisibility": "projection"
    },
    {
      "type": "species-resolution",
      "version": 1,
      "label": { "en": "Species resolution", "es": "Resolución de especies", "fr": "Résolution des espèces", "de": "Spezies-Auflösung", "pt": "Resolução de espécies", "pt-BR": "Resolução de espécies", "it": "Risoluzione delle specie", "tr": "Tür çözümlemesi" },
      "modelVisibility": "projection"
    },
    {
      "type": "structure-naming",
      "version": 1,
      "label": { "en": "Structure naming", "es": "Nombrado de estructuras", "fr": "Nommage des structures", "de": "Struktur-Benennung", "pt": "Nomeação de estruturas", "pt-BR": "Nomeação de estruturas", "it": "Denominazione delle strutture", "tr": "Yapı adlandırma" },
      "modelVisibility": "projection"
    },
    {
      "type": "reaction-precedent",
      "version": 1,
      "label": { "en": "Reaction precedent", "es": "Precedente de reacción", "fr": "Précédent de réaction", "de": "Reaktionspräzedenz", "pt": "Precedente de reação", "pt-BR": "Precedente de reação", "it": "Precedente di reazione", "tr": "Reaksiyon örneği" },
      "modelVisibility": "none"
    },
    {
      "type": "reaction-disconnections",
      "version": 1,
      "label": { "en": "Reaction disconnections", "es": "Desconexiones de reacción", "fr": "Déconnexions de réaction", "de": "Reaktionsdiskonnektionen", "pt": "Desconexões de reação", "pt-BR": "Desconexões de reação", "it": "Disconnessioni di reazione", "tr": "Reaksiyon ayrıştırmaları" },
      "modelVisibility": "none"
    },
    {
      "type": "target-decomposition",
      "version": 1,
      "label": { "en": "Target decomposition", "es": "Descomposición del objetivo", "fr": "Décomposition de la cible", "de": "Zielzerlegung", "pt": "Decomposição do alvo", "pt-BR": "Decomposição do alvo", "it": "Scomposizione del bersaglio", "tr": "Hedef ayrıştırması" },
      "modelVisibility": "none"
    },
    {
      "type": "stock-availability",
      "version": 1,
      "label": { "en": "Stock availability", "es": "Disponibilidad en catálogo", "fr": "Disponibilité en stock", "de": "Lagerverfügbarkeit", "pt": "Disponibilidade em stock", "pt-BR": "Disponibilidade em estoque", "it": "Disponibilità a catalogo", "tr": "Stok durumu" },
      "modelVisibility": "none"
    },
    {
      "type": "candidate-routes",
      "version": 1,
      "label": { "en": "Candidate routes", "es": "Rutas candidatas", "fr": "Voies candidates", "de": "Kandidatenrouten", "pt": "Rotas candidatas", "pt-BR": "Rotas candidatas", "it": "Vie candidate", "tr": "Aday rotalar" },
      "modelVisibility": "none"
    },
    {
      "type": "aggregation-advisory",
      "version": 1,
      "label": { "en": "Aggregation advisory", "es": "Aviso de agregación", "fr": "Avertissement d'agrégation", "de": "Aggregationshinweis", "pt": "Aviso de agregação", "pt-BR": "Aviso de agregação", "it": "Avviso di aggregazione", "tr": "Agregasyon uyarısı" },
      "modelVisibility": "none"
    },
    {
      "type": "step-compatibility",
      "version": 1,
      "label": { "en": "Functional-group compatibility", "es": "Compatibilidad de grupos funcionales", "fr": "Compatibilité des groupes fonctionnels", "de": "Verträglichkeit funktioneller Gruppen", "pt": "Compatibilidade de grupos funcionais", "pt-BR": "Compatibilidade de grupos funcionais", "it": "Compatibilità dei gruppi funzionali", "tr": "Fonksiyonel grup uyumluluğu" },
      "modelVisibility": "none"
    },
    {
      "type": "forward-steps",
      "version": 1,
      "label": {"en": "Forward steps", "es": "Pasos directos", "fr": "Étapes directes", "de": "Vorwärtsschritte", "pt": "Passos diretos", "pt-BR": "Passos diretos", "it": "Passaggi diretti", "tr": "İleri adımlar"},
      "modelVisibility": "projection"
    }
  ],
  "permissions": {
    "network": [
      { "id": "opsin", "origin": "https://www.ebi.ac.uk", "pathPrefixes": ["/opsin/ws/"], "methods": ["GET"], "maxResponseBytes": 1048576, "timeoutMs": 30000 },
      { "id": "pubchem", "origin": "https://pubchem.ncbi.nlm.nih.gov", "pathPrefixes": ["/rest/pug/compound/"], "methods": ["GET"], "maxResponseBytes": 4194304, "timeoutMs": 30000 },
      { "id": "wheels", "origin": "https://files.pythonhosted.org", "pathPrefixes": ["/packages/"], "methods": ["GET"], "maxResponseBytes": 268435456, "timeoutMs": 240000 }
    ],
    "runtimes": [
      { "id": "chemistry", "kind": "python", "minVersion": "3.11" }
    ],
    "model": { "maxCalls": 2, "purpose": "Repair a structurally invalid plan, or draw an explicitly unverified fallback when the verified lane abstains." },
    "svg": true,
    "subworkers": { "max": 1 },
    "storage": { "stateBytes": 65536, "cacheBytes": 4194304, "tempBytes": 0 }
  }
}
