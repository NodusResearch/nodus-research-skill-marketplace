{
  "schemaVersion": 1,
  "id": "anatomy",
  "version": "1.1.0",
  "description": "Deterministic, attributed SVG anatomy, packaged 3D reference meshes and curated semantic queries. English/Spanish terminology; no generated anatomy or runtime network access.",
  "runtime": "javascript-sandbox-v1",
  "entry": "runtime.js",
  "tools": [
    {
      "id": "render-anatomy",
      "description": "Render up to 12 curated English or Spanish terms as a deterministic attributed SVG. Optional language en/es, view auto/front/back/both, sex auto/male/female/both, labelMode names/numbers/none, legacy labels boolean, legend boolean, title. Unsupported or ambiguous anatomy and unsupported laterality fail explicitly.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "structures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "auto",
              "front",
              "back",
              "both"
            ]
          },
          "sex": {
            "type": "string",
            "enum": [
              "auto",
              "male",
              "female",
              "both"
            ]
          },
          "labels": {
            "type": "boolean"
          },
          "legend": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ]
          },
          "labelMode": {
            "type": "string",
            "enum": [
              "names",
              "numbers",
              "none"
            ]
          }
        },
        "required": [
          "structures"
        ],
        "additionalProperties": false
      },
      "resultKinds": [
        "svg"
      ]
    },
    {
      "id": "list-supported-structures",
      "description": "List verified geometry metadata. Default dimension svg preserves the existing catalog; dimension model returns paginated 3D coverage distinct from semantic terms. Includes aliases, language labels, ontology, laterality, source revisions, licences and limitations. Use query-anatomy for relationships.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "muscle",
              "muscle-group",
              "organ",
              "vessel",
              "tissue",
              "brain-region",
              "body-region"
            ]
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ]
          },
          "dimension": {
            "type": "string",
            "enum": [
              "svg",
              "model"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "resultKinds": [
        "json"
      ]
    },
    {
      "id": "render-anatomy-3d",
      "description": "Resolve curated anatomical entities and partial system collections to packaged read-only reference models for native nodus:3d. English/Spanish aliases and explicit source laterality. sex both keeps source models separate. Refuses unavailable geometry; returns stable node identities, source locks, licences and limitations. No remote URLs or model-authored geometry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "structures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "sex": {
            "type": "string",
            "enum": [
              "auto",
              "male",
              "female",
              "both"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "structures"
        ],
        "additionalProperties": false
      },
      "resultKinds": [
        "model"
      ]
    },
    {
      "id": "query-anatomy",
      "description": "Query only the pinned reference relationship graph. PART-OF and IS-A are source assertions; HAS-PART reverses PART-OF. Returns canonical namespace identifiers, edges and provenance; no inferred relations. Semantic coverage does not imply renderability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "structure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "relation": {
            "type": "string",
            "enum": [
              "part-of",
              "has-part",
              "is-a"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "structure",
          "relation"
        ],
        "additionalProperties": false
      },
      "resultKinds": [
        "json"
      ]
    }
  ],
  "permissions": {},
